ss, -let, -like, -ling, -ly, -ment, -ness, -or, -ory, -ous, -ship, -sion, -some, -tion, -tious, -tude, -ty, -ure, -ward, -wards, -wise, -y + +确保每个条目有 `root`、`type`、`meaning`、`meaning_en`、`origin`、`from`、`examples`、`priority`、`languages` 字段。 + +- [ ] **步骤 2：Commit** + +```bash +git add jerry520-yes.github.io/root.html +git commit -m "feat: add root database with ~300 roots, ~80 prefixes, ~80 suffixes" +``` + +--- + +### 任务 3：实现词根匹配引擎 + +**文件：** +- 修改：`jerry520-yes.github.io/root.html`（在 `<script>` 中追加引擎逻辑） + +- [ ] **步骤 1：编写匹配算法函数** + +```javascript +// 按类型和优先级排序的索引 +const ROOTS_BY_TYPE = { +  root: ROOT_DB.filter(e => e.type === 'root').sort((a,b) => b.priority - a.priority), +  prefix: ROOT_DB.filter(e => e.type === 'prefix').sort((a,b) => b.priority - a.priority), +  suffix: ROOT_DB.filter(e => e.type === 'suffix').sort((a,b) => b.priority - a.priority) +}; + +function analyzeWord(word) { +  if (!word || word.trim().length === 0) return null; +  const w = word.trim().toLowerCase(); +  let remaining = w; +  const parts = []; +   +  // 1. 前缀匹配 — 从开头匹配最长前缀 +  let matchedPrefix = null; +  for (const p of ROOTS_BY_TYPE.prefix) { +    if (remaining.startsWith(p.root)) { +      matchedPrefix = { ...p, matchedText: p.root, start: 0, end: p.root.length }; +      remaining = remaining.slice(p.root.length); +      break; +    } +  } +  if (matchedPrefix) parts.push(matchedPrefix); +   +  // 2. 词根匹配 — 从剩余部分找最长匹配 +  let matchedRoot = null; +  let bestRoot = null; +  for (const r of ROOTS_BY_TYPE.root) { +    const idx = remaining.indexOf(r.root); +    if (idx !== -1) { +      if (!bestRoot || r.root.length > bestRoot.root.length) { +        bestRoot = { ...r, matchedText: r.root, start: matchedPrefix ? matchedPrefix.end + idx : idx, end: (matchedPrefix ? matchedPrefix.end + idx : idx) + r.root.length }; +      } +    } +  } +  if (bestRoot) { +    matchedRoot = bestRoot; +    parts.push(matchedRoot); +  } +   +  // 3. 后缀匹配 — 从剩余尾部匹配最长后缀 +  // 去掉已匹配的词根部分重新计算剩余 +  remaining = w; +  if (matchedPrefix) remaining = remaining.slice(matchedPrefix.root.length); +  if (matchedRoot) { +    const rootIdx = remaining.indexOf(matchedRoot.root); +    if (rootIdx !== -1) { +      remaining = remaining.slice(rootIdx + matchedRoot.root.length); +    } +  } +   +  let matchedSuffix = null; +  for (const s of ROOTS_BY_TYPE.suffix) { +    if (remaining.endsWith(s.root)) { +      matchedSuffix = { ...s, matchedText: s.root, start: w.length - s.root.length, end: w.length }; +      remaining = remaining.slice(0, remaining.length - s.root.length); +      break; +    } +  } +  if (matchedSuffix) parts.push(matchedSuffix); +   +  // 4. 未识别部分 +  let unmatched = w; +  // 从剩余中算出未匹配部分 +  const unrecognized = []; +  if (matchedPrefix) unmatched = unmatched.slice(matchedPrefix.root.length); +  if (matchedRoot) { +    const rootIdx = unmatched.indexOf(matchedRoot.root); +    if (rootIdx > 0) unrecognized.push({ text: unmatched.slice(0, rootIdx), type: 'unrecognized' }); +    unmatched = unmatched.slice(rootIdx + matchedRoot.root.length); +  } +  if (matchedSuffix) { +    unmatched = unmatched.slice(0, unmatched.length - matchedSuffix.root.length); +  } +  if (unmatched.length > 0) unrecognized.push({ text: unmatched, type: 'unrecognized' }); +   +  return { word: w, parts, unrecognized }; +} +``` + +- [ ] **步骤 2：编写输入框自动分析逻辑（带防抖）** + +```javascript +const input = document.getElementById('word-input'); +const resultsEl = document.getElementById('results'); +let debounceTimer; + +input.addEventListener('input', function() { +  clearTimeout(debounceTimer); +  const word = this.value.trim(); +  if (word.length === 0) { +    resultsEl.innerHTML = '<div class="placeholder">输入单词，自动拆解词根...</div>'; +    return; +  } +  debounceTimer = setTimeout(() => { +    const result = analyzeWord(word); +    renderResults(result); +  }, 300); // 300ms 防抖 +}); +``` + +- [ ] **步骤 3：Commit** + +```bash +git add jerry520-yes.github.io/root.html +git commit -m "feat: implement root matching engine with prefix/root/suffix analysis" +``` + +--- + +### 任务 4：实现结果渲染与卡片交互 + +**文件：** +- 修改：`jerry520-yes.github.io/root.html` + +- [ ] **步骤 1：编写卡片渲染函数** + +```javascript +function renderResults(result) { +  if (!result || result.parts.length === 0) { +    resultsEl.innerHTML = ` +      <div class="no-match"> +        <div class="no-match-icon">&#128269;</div> +        <p>未找到词根匹配</p> +        <p class="no-match-hint">试试启用 AI 增强模式，或检查单词拼写</p> +      </div>`; +    return; +  } +   +  let html = '<div class="cards-grid">'; +   +  // 先展示未识别部分 +  for (const u of result.unrecognized) { +    html += ` +      <div class="root-card unrecognized"> +        <div class="root-card-type">未识别</div> +        <div class="root-card-root">${u.text}</div> +        <div class="root-card-meaning">未匹配到词根</div> +        <div class="root-card-origin">—</div> +      </div>`; +  } +   +  // 展示匹配的每个部分 +  for (const p of result.parts) { +    const typeLabel = p.type === 'prefix' ? '前缀' : p.type === 'suffix' ? '后缀' : '词根'; +    const examplesHtml = p.examples.slice(0,5).map(ex =>  +      `<span class="root-example" data-word="${ex}">${ex}</span>` +    ).join(''); +     +    html += ` +      <div class="root-card" data-type="${p.type}"> +        <div class="root-card-type">${typeLabel}</div> +        <div class="root-card-root">${p.root}</div> +        <div class="root-card-meaning">${p.meaning}<br><span class="meaning-en">${p.meaning_en}</span></div> +        <div class="root-card-origin">${p.origin}${p.from ? ' · ' + p.from : ''}</div> +        ${examplesHtml ? `<div class="root-card-examples">${examplesHtml}</div>` : ''} +      </div>`; +  } +   +  html += '</div>'; +   +  // 添加整体拼合说明 +  html += '<div class="analysis-summary">'; +  const partsStr = result.parts.map(p => `${p.root} (${p.meaning})`).join(' + '); +  html += `<p><strong>拆解：</strong> ${result.word} = ${partsStr}</p>`; +  html += '</div>'; +   +  resultsEl.innerHTML = html; +} +``` + +- [ ] **步骤 2：实现同根词点击交互** + +```javascript +// 事件委托：点击同根词触发新查询 +resultsEl.addEventListener('click', function(e) { +  const example = e.target.closest('.root-example'); +  if (example) { +    const word = example.dataset.word; +    input.value = word; +    input.dispatchEvent(new Event('input')); +    // 滚动到输入区 +    input.scrollIntoView({ behavior: 'smooth', block: 'center' }); +  } +}); +``` + +- [ ] **步骤 3：编写卡片 CSS 样式** + +```css +.cards-grid{ +  display:flex;flex-wrap:wrap;gap:16px;margin-top:24px; +} +.root-card{ +  flex:1;min-width:220px;max-width:280px;background:var(--bg); +  border-radius:var(--radius);padding:24px 20px;border:1px solid var(--rule); +  border-left:4px solid var(--accent);transition:all 0.25s; +  display:flex;flex-direction:column; +} +.root-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(39,174,96,0.12)} +.root-card[data-type="prefix"]{border-left-color:#3498db} +.root-card[data-type="suffix"]{border-left-color:#e74c3c} +.root-card.unrecognized{border-left-color:#adb5bd;opacity:0.7} + +.root-card-type{ +  font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em; +  color:var(--muted);font-weight:700;margin-bottom:8px; +} +.root-card-root{ +  font-size:1.6rem;font-weight:800;color:var(--accent);font-family:var(--mono); +  margin-bottom:12px; +} +.root-card[data-type="prefix"] .root-card-root{color:#3498db} +.root-card[data-type="suffix"] .root-card-root{color:#e74c3c} +.root-card-meaning{font-size:0.9rem;color:var(--ink);margin-bottom:8px;line-height:1.5} +.root-card-meaning .meaning-en{color:var(--muted);font-size:0.8rem} +.root-card-origin{font-size:0.8rem;color:var(--muted);margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--rule)} +.root-card-examples{display:flex;flex-wrap:wrap;gap:6px;margin-top:auto} +.root-example{ +  background:var(--accent-dim);color:var(--accent);padding:3px 10px;border-radius:12px; +  font-size:0.75rem;cursor:pointer;transition:all 0.2s;font-family:var(--mono); +} +.root-example:hover{background:var(--accent);color:#fff} + +.analysis-summary{ +  margin-top:24px;padding:20px 24px;background:var(--accent-dim); +  border-radius:var(--radius);font-size:0.95rem;line-height:1.6; +} +.analysis-summary strong{color:var(--accent)} + +.no-match{text-align:center;padding:60px 20px;color:var(--muted)} +.no-match-icon{font-size:3rem;opacity:0.3;margin-bottom:16px} +.no-match-hint{font-size:0.85rem;margin-top:8px} +``` + +- [ ] **步骤 4：Commit** + +```bash +git add jerry520-yes.github.io/root.html +git commit -m "feat: implement root card rendering with clickable example words" +``` + +--- + +### 任务 5：实现 AI 增强模式 + +**文件：** +- 修改：`jerry520-yes.github.io/root.html` + +- [ ] **步骤 1：编写 API Key 设置面板 HTML** + +在输入区下方添加设置面板，与 Summarizer 一致的 UI 模式： + +```html +<div class="tool-bar"> +  <div class="tool-bar-left"> +    <div class="control-group"> +      <label for="lang-select">语言</label> +      <select id="lang-select" class="tool-select"> +        <option value="en">英语</option> +        <option value="fr">法语</option> +        <option value="es">西班牙语</option> +        <option value="it">意大利语</option> +        <option value="auto">自动检测</option> +      </select> +    </div> +    <div class="ai-toggle-wrap"> +      <button id="ai-toggle" class="ai-toggle" onclick="toggleAI()"></button> +      <span class="ai-toggle-label">AI 增强</span> +    </div> +  </div> +  <button id="btn-api-key" class="btn-api-key" onclick="toggleApiPanel()">&#9881; API Key</button> +</div> + +<div id="api-key-panel" class="api-key-panel"> +  <label for="api-key-input">OpenAI API Key</label> +  <div class="api-key-row"> +    <input id="api-key-input" type="password" placeholder="sk-..." /> +    <button onclick="saveApiKey()">保存</button> +  </div> +  <p class="api-key-hint">API Key 仅保存在本地浏览器，不会上传到服务器。<br>需要 <code>gpt-3.5-turbo</code> 及以上模型。</p> +</div> +``` + +- [ ] **步骤 2：编写 AI 增强 JavaScript** + +```javascript +let aiEnabled = localStorage.getItem('root_ai_enabled') === 'true'; +let apiKey = localStorage.getItem('root_api_key') || ''; + +function toggleAI() { +  aiEnabled = !aiEnabled; +  localStorage.setItem('root_ai_enabled', aiEnabled); +  document.getElementById('ai-toggle').classList.toggle('on', aiEnabled); +  // 如果有当前结果，重新分析 +  const word = input.value.trim(); +  if (word) { +    input.dispatchEvent(new Event('input')); +  } +} + +function toggleApiPanel() { +  document.getElementById('api-key-panel').classList.toggle('show'); +} + +function saveApiKey() { +  apiKey = document.getElementById('api-key-input').value.trim(); +  localStorage.setItem('root_api_key', apiKey); +  document.getElementById('api-key-panel').classList.remove('show'); +} + +async function analyzeWithAI(word, language) { +  if (!apiKey) { +    showToast('请先设置 API Key'); +    return null; +  } +   +  const prompt = `分析单词 "${word}" 的词根词源结构。 +语言：${language} +要求： +1. 拆解前缀/词根/后缀，每个部分给出含义 +2. 给出词源来源（拉丁语/希腊语/古法语等） +3. 给出整体含义的演变逻辑 +4. 对每个组成部分给出 2-3 个同根词示例 +5. 以 JSON 格式返回，格式：{ "parts": [{"type":"prefix/root/suffix","root":"...","meaning":"...","origin":"...","examples":[...]}], "summary": "..." }`; + +  try { +    const resp = await fetch('https://api.openai.com/v1/chat/completions', { +      method: 'POST', +      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${apiKey}` }, +      body: JSON.stringify({ +        model: 'gpt-3.5-turbo', +        messages: [{ role: 'user', content: prompt }], +        temperature: 0.3, +        max_tokens: 1000 +      }) +    }); +    const data = await resp.json(); +    const content = data.choices?.[0]?.message?.content; +    if (content) { +      try { +        return JSON.parse(content); +      } catch { +        // 如果不是 JSON，返回原文 +        return { raw: content }; +      } +    } +  } catch (err) { +    console.error('AI analysis failed:', err); +  } +  return null; +} +``` + +- [ ] **步骤 3：在分析函数中集成 AI** + +修改 `analyzeWord` 的调用流程，当 AI 增强开启时，在本地分析后并行发起 AI 请求，用 AI 结果覆盖或补充： + +```javascript +async function performAnalysis(word) { +  // 先做本地分析 +  const localResult = analyzeWord(word); +   +  if (aiEnabled && apiKey) { +    // 显示加载状态 +    const aiSummary = document.getElementById('ai-summary'); +    if (aiSummary) { +      aiSummary.innerHTML = '<div class="ai-loading"><span class="spinner"></span> AI 分析中...</div>'; +      aiSummary.style.display = 'block'; +    } +     +    const lang = document.getElementById('lang-select').value; +    const aiResult = await analyzeWithAI(word, lang); +     +    if (aiResult) { +      renderAIResult(aiResult, localResult); +    } else { +      // AI 失败，降级到本地结果 +      renderResults(localResult); +    } +  } else { +    document.getElementById('ai-summary').style.display = 'none'; +    renderResults(localResult); +  } +} +``` + +- [ ] **步骤 4：编写 AI 结果渲染函数** + +```javascript +function renderAIResult(aiResult, localResult) { +  // 渲染本地结果作为基础 +  renderResults(localResult); +   +  // 渲染 AI 摘要 +  const aiSummary = document.getElementById('ai-summary'); +  let html = '<div class="ai-section">'; +  html += '<div class="ai-section-header">'; +  html += '<span class="ai-badge">AI 增强</span>'; +  html += '</div>'; +   +  if (aiResult.parts) { +    html += '<div class="ai-parts">'; +    for (const p of aiResult.parts) { +      html += `<div class="ai-part"> +        <span class="ai-part-type">${p.type}</span> +        <strong>${p.root}</strong> — ${p.meaning} +        <span class="ai-part-origin">${p.origin || ''}</span> +      </div>`; +    } +    html += '</div>'; +  } +   +  if (aiResult.summary) { +    html += `<div class="ai-summary-text">${aiResult.summary}</div>`; +  } +   +  if (aiResult.raw) { +    html += `<div class="ai-raw">${aiResult.raw}</div>`; +  } +   +  html += '</div>'; +  aiSummary.innerHTML = html; +  aiSummary.style.display = 'block'; +} +``` + +- [ ] **步骤 5：编写 AI 摘要区域 CSS** + +```css +#ai-summary{display:none;margin-top:20px} +.ai-section{ +  background:linear-gradient(135deg,#e8f5e9 0%,#f1f8e9 100%); +  border-radius:var(--radius);padding:24px;border:1px solid #c8e6c9; +} +.ai-section-header{display:flex;align-items:center;margin-bottom:16px} +.ai-badge{ +  background:var(--accent);color:#fff;padding:3px 12px;border-radius:10px; +  font-size:0.75rem;font-weight:700; +} +.ai-parts{display:flex;flex-direction:column;gap:8px;margin-bottom:16px} +.ai-part{padding:8px 12px;background:rgba(255,255,255,0.7);border-radius:6px;font-size:0.9rem} +.ai-part-type{ +  font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em; +  color:var(--muted);font-weight:700;margin-right:8px; +} +.ai-part-origin{color:var(--muted);font-size:0.8rem;margin-left:8px} +.ai-summary-text{ +  padding:16px;background:rgba(255,255,255,0.7);border-radius:8px; +  font-size:0.95rem;line-height:1.7;border-left:4px solid var(--accent); +} +.ai-raw{white-space:pre-wrap;font-size:0.85rem;color:var(--muted);margin-top:12px} +.ai-loading{display:flex;align-items:center;gap:12px;color:var(--muted);padding:20px} +``` + +- [ ] **步骤 6：Commit** + +```bash +git add jerry520-yes.github.io/root.html +git commit -m "feat: add AI enhancement mode with API key panel and OpenAI integration" +``` + +--- + +### 任务 6：更新首页 index.html + +**文件：** +- 修改：`jerry520-yes.github.io/index.html` + +- [ ] **步骤 1：替换"即将上线"卡片为 Root 项目卡片** + +在 `index.html` 中，找到 `coming-soon` 卡片并将其替换为： + +```html +<a href="root" class="project-card" style="--card-color:#27AE60;--card-dim:#e8f5e9"> +  <span class="project-badge">在线可用</span> +  <div class="project-icon">&#127793;</div> +  <h3>Root</h3> +  <p class="project-desc">输入单词，智慧拆解词根，卡片式展示词源结构。支持英语、法语、西班牙语、意大利语等多语言，本地词根库 + AI 增强。</p> +  <div class="project-tags"> +    <span class="project-tag">词根分析</span> +    <span class="project-tag">多语言</span> +    <span class="project-tag">在线工具</span> +  </div> +  <span class="project-link">查看项目 &rarr;</span> +</a> +``` + +- [ ] **步骤 2：更新统计数字** + +将 `3` 在线项目改为 `4`： + +```html +<div class="stat-num" style="color:#E74C3C">4</div> +``` + +- [ ] **步骤 3：Commit** + +```bash +git add jerry520-yes.github.io/index.html +git commit -m "feat: add Root project card to homepage, update stats to 4 projects" +``` + +--- + +## 规格覆盖度检查 + +| 规格需求 | 对应任务 | +|---------|---------| +| 自动拆解（输入即分析，带防抖） | 任务 3 | +| 卡片展示（每个词根独立卡片） | 任务 4 | +| 本地词根库 ~600 条 | 任务 2 | +| AI 增强（API Key 面板 + OpenAI） | 任务 5 | +| 多语言支持（语言选择下拉框） | 任务 5 | +| 同根词导航（点击同根词跳转查询） | 任务 4 | +| 卡片内容（词根名、含义、来源、同根词） | 任务 2 + 任务 4 | +| 绿色主题配色 #27AE60 | 任务 1 | +| 页面布局（hero/输入/结果/特性/用法/页脚） | 任务 1 | +| 首页添加 Root 卡片 | 任务 6 | +| 版权声明 | 任务 1 | \ No newline at end of file diff --git a/docs/superpowers/specs/2026-08-20-root-project-design.md b/docs/superpowers/specs/2026-08-20-root-project-design.md new file mode 100644 index 0000000..f495e8e --- /dev/null +++ b/docs/superpowers/specs/2026-08-20-root-project-design.md @@ -0,0 +1,151 @@ +# Root 项目 — 词根拆解工具设计文档 + +> 日期：2026-08-20 +> 状态：设计完成，待实现 + +## 1. 概述 + +Root 是一个拉丁语系（西欧语言）单词词根智慧拆解工具。用户输入一个单词，系统自动拆解为前缀、词根、后缀，并以卡片形式展示每个组成部分的详细信息。 + +## 2. 技术方案 + +**方案 C：本地优先 + AI 增强（推荐）** + +- 本地词根库做第一层快速拆解，常见词即时出结果，离线可用 +- 用户输入 API Key 后启用 AI 增强，提供更精准的拆解和详细解释 +- 在线模式优先用 AI，API 失败时降级到本地结果 + +## 3. 功能需求 + +### 3.1 核心功能 + +| 功能 | 描述 | +|------|------| +| 自动拆解 | 输入单词后自动触发词根分析，无需按钮 | +| 卡片展示 | 每个词根/前缀/后缀以独立卡片展示 | +| 本地词根库 | 内置 ~600 条词根/前缀/后缀，支持离线拆解 | +| AI 增强 | 通过 API Key 调用 AI 获得更精准拆解和详细解释 | +| 多语言支持 | 主要支持英语，覆盖法语、西班牙语、意大利语等拉丁语系 | +| 同根词导航 | 卡片上的同根词可点击，自动填入输入框并触发新查询 | + +### 3.2 卡片内容 + +每张卡片展示： +- 词根名称（如 `tract-`） +- 含义（中英文，如 "拉，拖 / pull, draw"） +- 来源语言（如 "拉丁语 · trahere"） +- 同根词举例（3-5 个，可点击） +- 类型标签（词根/前缀/后缀） + +### 3.3 AI 增强模式 + +- 与 Summarizer 一致的 API Key 设置面板（localStorage 持久化） +- 启用后 AI 提供更详细的拆解、词源演变、整体含义推导 +- 显示整体分析摘要："ex-(向外) + tract-(拉) + -able(能) → 可提取的" + +## 4. 页面设计 + +### 4.1 页面布局 + +沿用现有子页面模板结构： + +``` +<nav>          ← 顶部导航栏 +<hero>         ← 渐变横幅 + 标题 + 描述 +<section id="try">     ← 核心交互区 +  ├── 输入区（输入框 + 语言选择 + API Key 设置） +  └── 结果区（卡片网格 + AI 分析摘要） +<section id="features">  ← 特性介绍 +<section id="usage">     ← 使用方法 +<footer>                 ← 版权声明 +``` + +### 4.2 配色方案 + +- **主题色：** `#27AE60`（绿色 — 象征根源、生长、知识） +- **Hero 渐变：** `#27AE60 → #1E8449` +- **卡片色：** `--card-color: #27AE60`, `--card-dim: #e8f5e9` +- **首页卡片：** 绿色系，与现有项目颜色不重复 + +### 4.3 交互方式 + +- 输入即分析，自动拆解（input 事件触发，带防抖） +- 点击同根词 → 填入输入框并触发新查询 +- 语言选择下拉框切换分析语言范围 +- API Key 设置面板弹出式 + +## 5. 技术架构 + +### 5.1 本地词根库 + +```javascript +// 词根条目结构 +{ +  root: "tract",          // 词根 +  type: "root",           // root / prefix / suffix +  meaning: "拉，拖", +  meaning_en: "pull, draw", +  origin: "拉丁语", +  from: "拉丁语 trahere", +  examples: ["tractor", "extract", "attract", "contract", "subtract"], +  priority: 1,            // 1普通，2高频，3核心 +  languages: ["en", "fr", "es"]  // 适用语言 +} +``` + +**词根库规模：** +- 核心词根 ~300 条（覆盖 80% 常见词） +- 前缀 ~100 条（ex-, re-, pre-, in-, de- 等） +- 后缀 ~150 条（-able, -tion, -ment, -ity 等） +- 扩展词根 ~200 条（中低频） + +### 5.2 匹配算法 + +``` +1. 前缀匹配 — 从单词开头匹配最长前缀 +2. 词根匹配 — 从剩余部分找最长匹配词根 +3. 后缀匹配 — 从剩余尾部匹配最长后缀 +4. 未识别部分 — 标注为"未识别片段" +5. AI 增强 — 可选，并行或补充分析 +``` + +### 5.3 AI Prompt + +``` +分析单词 "{word}" 的词根词源结构。 +语言：{language} +要求： +1. 拆解前缀/词根/后缀，每个部分给出含义 +2. 给出词源来源（拉丁语/希腊语/古法语等） +3. 给出整体含义的演变逻辑 +4. 对每个组成部分给出 2-3 个同根词示例 +5. 以 JSON 格式返回 +``` + +## 6. 文件结构 + +``` +jerry520-yes.github.io/ +├── index.html           ← 首页（新增 Root 卡片） +├── root.html            ← Root 项目页面（新文件） +└── docs/superpowers/specs/ +    └── 2026-08-20-root-project-design.md  ← 本文件 +``` + +## 7. 首页卡片 + +| 字段 | 值 | +|------|-----| +| href | `root` | +| 卡片颜色 | `--card-color:#27AE60; --card-dim:#e8f5e9` | +| 图标 | `🌿` | +| 标题 | `Root` | +| 描述 | 输入单词，智慧拆解词根，卡片式展示词源结构 | +| 标签 | 词根分析 / 多语言 / 在线工具 | +| 状态 | 在线可用 | + +## 8. 版权声明 + +``` +Root · 可免费使用，不开源，使用时需要标注水印 · 2026 Jerry520-YES +``` \ No newline at end of file diff --git a/root.html b/root.html new file mode 100644 index 0000000..9ad85c6 --- /dev/null +++ b/root.html @@ -0,0 +1,320 @@ +<!-- Generated by Trae Work --> +<!DOCTYPE html> +<html lang="zh-CN"> +<head> +<meta charset="UTF-8"> +<meta name="viewport" content="width=device-width, initial-scale=1.0"> +<title>Root — 词根拆解工具 | Jerry520-YES</title> +<meta name="description" content=